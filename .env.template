# Copy to `.env` for LOCAL runs only. Never commit `.env`. On GitHub, use Settings -> Secrets and variables -> Actions.

# REQUIRED — the BOT account's token: https://www.metaculus.com/futureeval/participate/
METACULUS_TOKEN=REPLACE_ME

# REQUIRED — the OpenRouter key (Metaculus-sponsored credits via the participation form, or your own key)
OPENROUTER_API_KEY=REPLACE_ME

# OPTIONAL — AskNews (sponsored for participants); without it, news research uses Perplexity Sonar via OpenRouter
# ASKNEWS_API_KEY=REPLACE_ME       # current key format
# ASKNEWS_CLIENT_ID=REPLACE_ME     # or the older client ID + secret pair
# ASKNEWS_SECRET=REPLACE_ME

# OPTIONAL spending controls (defaults in config.py)
# BOT_TIER_MAIN=balanced         # premium / standard / balanced / minimal
# BOT_TIER_MINIBENCH=balanced
# BOT_SOFT_FLOOR_USD=15          # below this remaining credit: cheapest tier
# BOT_HARD_FLOOR_USD=3           # below this: no forecasting
